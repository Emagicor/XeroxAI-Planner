# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Feature flags (optional overrides — APP_ENV sets defaults)
# FEATURE_OPENAPI=true          # Swagger /docs (off when APP_ENV=production)
# FEATURE_VISION_PROMPT_LOG=true  # Raw model output logs (off when APP_ENV=production)

# Vision (set at least one API key)
VISION_PROVIDER=gemini
GEMINI_API_KEY=
# Prefer gemini-2.5-flash — avoid gemini-3.5-flash on free tier (often 20 req/day)
GEMINI_MODEL=gemini-3.5-flash

# Optional: different provider/model for the correction pass (pass 2).
# Empty = same as VISION_PROVIDER / provider default model above.
VISION_CORRECTION_PROVIDER=openai
VISION_CORRECTION_MODEL=gpt-4o

# Vision API usage (1 image ≈ 1–2 Gemini calls with defaults below)
MAX_ANALYSIS_ATTEMPTS=1
VISION_TWO_PASS=false
VISION_CORRECTION_PASS=true
# Rooms at/below this confidence_pct (and all derived/assumed) go to selective pass 2
VISION_CORRECTION_CONFIDENCE_MAX=84
GEMINI_TRANSIENT_RETRIES=0

# Log raw floor-plan vs correction model outputs (dev only; disabled in production)
# VISION_PROMPT_LOG_ENABLED=true
# VISION_PROMPT_LOG_DIR=

# Optional second provider for benchmarking
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional Groq provider (test-suite model selection)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional Florence-2 provider (local HuggingFace transformers inference)
# VISION_PROVIDER=florence2
# FLORENCE2_MODEL=microsoft/Florence-2-large
# FLORENCE2_TASK=<OCR_WITH_REGION>
# FLORENCE2_DEVICE=auto
# FLORENCE2_MAX_NEW_TOKENS=4096
# HUGGINGFACE_TOKEN=

# Optional Qwen2.5-VL provider (Hugging Face Inference Providers — cloud)
# VISION_PROVIDER=qwen25_vl
# HUGGINGFACE_TOKEN=hf_...
# QWEN25_VL_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# QWEN25_VL_INFERENCE_PROVIDER=auto
# QWEN25_VL_MAX_TOKENS=4096
# QWEN25_VL_TRANSIENT_RETRIES=1
# Optional self-hosted OpenAI-compatible endpoint (vLLM/TGI):
# QWEN25_VL_BASE_URL=https://your-endpoint.example.com/v1

# Upload limits
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=100

# PDF → image (lossless PNG at 300 DPI recommended for colored architectural plans)
# PDF_RENDER_DPI=300
# PDF_RASTER_FORMAT=png

# Region clipping (full-page per sheet)
# DETECTION_CLIP_PADDING_RATIO=0.035

# Benchmarking — logs token usage per page when true
BENCHMARK_MODE=false

# Temp directory (created automatically; cleaned after each request)
TEMP_DIR=C:/Users/ASUS/AppData/Local/Temp/zerox
