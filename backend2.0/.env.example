# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Vision (set at least one API key)
VISION_PROVIDER=gemini
GEMINI_API_KEY=
# Prefer gemini-2.5-flash — avoid gemini-3.5-flash on free tier (often 20 req/day)
GEMINI_MODEL=gemini-2.5-flash

# Vision API usage (1 image ≈ 1–2 Gemini calls with defaults below)
MAX_ANALYSIS_ATTEMPTS=1
VISION_TWO_PASS=false
VISION_CORRECTION_PASS=true
GEMINI_TRANSIENT_RETRIES=0

# Optional second provider for benchmarking
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Upload limits
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=100

# PDF → image (lossless PNG at 300 DPI recommended for colored architectural plans)
# PDF_RENDER_DPI=300
# PDF_RASTER_FORMAT=png

# Grounding DINO — floor plan region detection before vision analysis
# Use local repo (recommended): no HuggingFace download, runs fully offline
GROUNDING_DINO_BACKEND=local
GROUNDING_DINO_ENABLED=true
# Point at your clone (optional; default is backend2.0/groundingdino_local)
# GROUNDING_DINO_REPO_PATH=C:/Users/ASUS/Documents/GroundingDINO/GroundingDINO
GROUNDING_DINO_DEVICE=cpu
GROUNDING_DINO_THRESHOLD=0.30
GROUNDING_DINO_THRESHOLD_FALLBACK=0.22
GROUNDING_DINO_TEXT_THRESHOLD=0.25
# HuggingFace backend only:
# GROUNDING_DINO_BACKEND=huggingface
# GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-tiny
# Looser clips (include title blocks): raise DETECTION_BBOX_PADDING (default 0.10)
# DETECTION_CLIP_PADDING_RATIO=0.035
# More plans kept separate: raise DETECTION_MERGE_IOU (default 0.12)

# Benchmarking — logs token usage per page when true
BENCHMARK_MODE=false

# Temp directory (created automatically; cleaned after each request)
TEMP_DIR=C:/Users/ASUS/AppData/Local/Temp/zerox
