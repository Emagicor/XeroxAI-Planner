# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Vision (set at least one API key)
VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional second provider for benchmarking
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Upload limits
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=100

# Benchmarking — logs token usage per page when true
BENCHMARK_MODE=false

# Temp directory (created automatically; cleaned after each request)
TEMP_DIR=C:/Users/ASUS/AppData/Local/Temp/zerox
